# Render sets PORT automatically. Local default is 8000 via start-backend.ps1.
PORT=10000

# Comma-separated origins, or * for any. No trailing slashes.
# Example: https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=*

# Optional persistent disk (Render Disk mount). Without this, SQLite +
# uploaded frames/faces reset on every deploy / spin-down.
# DATA_DIR=/data
# DB_PATH=/data/facematcher.db
# STATIC_DIR=/data/static

# Render HTTP timeout is ~100s. Keep videos short in production.
MAX_VIDEO_DURATION_SEC=90

TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0
